# Copy this file to `.env` (`make setup` does it for you).
# `.env` is git-ignored: never commit real secrets.

# --- Django -----------------------------------------------------------------
# Local development only. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (local Docker container) ------------------------------------
POSTGRES_DB=accrubook
POSTGRES_USER=accrubook
POSTGRES_PASSWORD=accrubook
DATABASE_URL=postgres://accrubook:accrubook@db:5432/accrubook
# Port exposed on your machine (change it if 5432 is already in use)
POSTGRES_HOST_PORT=5432